# Vercel 部署环境变量配置示例

# 复制此文件内容到 Vercel 项目设置中的 Environment Variables

# Supabase 配置（複製此檔為 .env 後填入真實值；此範本一律只放佔位符）
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key（僅用於服务端腳本/Edge Functions，勿暴露於客戶端）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 其他环境变量（如有需要）
# VITE_API_URL=https://api.example.com
