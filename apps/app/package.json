{
  "name": "care-suite-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "NODE_PATH=./node_modules expo start --web",
    "export:web": "NODE_PATH=./node_modules expo export --platform web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "test": "jest",
    "postinstall": "node -e \"const p=require('path'),fs=require('fs');['react','react-dom'].forEach(m=>{const t=p.resolve('node_modules/expo-router/node_modules',m);if(fs.existsSync(t)&&!fs.lstatSync(t).isSymbolicLink()){fs.rmSync(t,{recursive:true});fs.symlinkSync(p.resolve('../../node_modules',m),t);}});const reactTypes=p.resolve('node_modules/@types/react');if(fs.existsSync(reactTypes)&&!fs.lstatSync(reactTypes).isSymbolicLink()){fs.rmSync(reactTypes,{recursive:true});fs.symlinkSync(p.resolve('../../node_modules/@types/react'),reactTypes);}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/drawer": "^7.12.0",
    "@react-navigation/native": "^7.3.1",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.0.0",
    "expo": "~54.0.30",
    "expo-camera": "~17.0.10",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets-core": "^1.6.2",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.28",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@shared/(.*)$": "<rootDir>/../../packages/shared/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@tanstack/.*)"
    ]
  },
  "overrides": {
    "@types/react": "18.3.28"
  },
  "private": true
}
