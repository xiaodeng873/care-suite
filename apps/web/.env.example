# Supabase Configuration
# 複製此檔案為 .env 並填入您的 Supabase 專案憑證

# 您的 Supabase 專案 URL
VITE_SUPABASE_URL=your-supabase-url-here

# 您的 Supabase 專案匿名金鑰 (Anon Key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key（僅用於服务端/管理腳本，切勿於前端使用）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ⚠️ 重要提示:
# 此範本一律只放佔位符，真實憑證請填入本機的 .env（.env 已被 gitignore，不會進版本庫）
# 應用程式一律從環境變數讀取，程式碼內不硬編碼任何憑證
